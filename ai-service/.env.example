BACKEND_URL=http://127.0.0.1:4000
SERVICE_KEY=change-me-too
# Optional: enables Claude for WattCycle Intelligence (otherwise an offline data router answers)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
S3_BUCKET=
# Assistant provider: bedrock (Claude in Amazon Bedrock via AWS credential chain) | anthropic (ANTHROPIC_API_KEY) | offline
ASSISTANT_PROVIDER=
AWS_REGION=ap-south-1
# S3_BUCKET above: trained model versions are mirrored to s3://$S3_BUCKET/ml/models/
