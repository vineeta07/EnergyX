PORT=4000
# Empty = embedded PGlite (real PostgreSQL in WASM, stored in ./data/pg). Set for Docker/RDS:
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
# Shared secret between this API and the Python AI service. Never exposed to the browser.
SERVICE_KEY=change-me-too
AI_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:3000
# Demo mode: simulated vehicle telemetry (replace with IoT Core in production)
SIMULATE_FLEET=true
FLEET_SPEEDUP=25
# AWS mode
S3_BUCKET=
